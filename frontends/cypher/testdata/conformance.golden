  -> at 1:9 cypher: not supported yet (jaala#364): a label expression with | ! % or parentheses

MATCH (a:!Library) RETURN a
  -> at 1:9 cypher: not supported yet (jaala#364): a label expression with | ! % or parentheses

MATCH (a:%) RETURN a
  -> at 1:9 cypher: not supported yet (jaala#364): a label expression with | ! % or parentheses

MATCH (a:(Package|Library)&!Test) RETURN a
  -> at 1:9 cypher: not supported yet (jaala#364): a label expression with | ! % or parentheses

MATCH (a)-[:IMPORTS&DEPENDS_ON]->(b) RETURN b
  -> at 1:12 cypher: not supported yet (jaala#364): a relationship type expression with & ! % or parentheses

MATCH (a)-[:!IMPORTS]->(b) RETURN b
  -> at 1:12 cypher: not supported yet (jaala#364): a relationship type expression with & ! % or parentheses

MATCH (a:Package) WHERE a:Package|Library RETURN a
  -> at 1:26 cypher: not supported yet (jaala#364): a label expression with | ! % or parentheses

